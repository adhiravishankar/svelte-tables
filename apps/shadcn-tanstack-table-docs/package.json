{
  "name": "shadcn-svelte-tanstack-table-docs",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "generate:api": "node scripts/generate-api.mjs",
    "predev": "node scripts/generate-api.mjs",
    "dev": "astro dev --port 3000",
    "prebuild": "node scripts/generate-api.mjs",
    "build": "astro build",
    "preview": "astro preview --port 4000",
    "check": "astro check && svelte-check --tsconfig ./tsconfig.json",
    "astro": "astro",
    "build:cloudflare": "npm run build -w shadcn-svelte-tanstack-table && astro build",
    "deploy": "npm run build:cloudflare && wrangler pages deploy",
    "preview:cloudflare": "wrangler pages dev ./dist"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/starlight": "^0.42.7",
    "@astrojs/svelte": "^9.1.1",
    "@faker-js/faker": "^10.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.2",
    "shadcn-svelte-tanstack-table": "*",
    "svelte": "^5.57.3",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "devDependencies": {
    "svelte-check": "^4.7.7"
  }
}
