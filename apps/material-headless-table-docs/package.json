{
  "name": "material-svelte-headless-table-docs",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev --port 3000",
    "build": "astro build",
    "preview": "astro preview --port 4000",
    "check": "astro check && svelte-check --tsconfig ./tsconfig.json",
    "astro": "astro",
    "build:cloudflare": "npm run build -w material-svelte-headless-table && astro build",
    "deploy": "npm run build:cloudflare && wrangler pages deploy",
    "preview:cloudflare": "wrangler pages dev ./dist"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-remark": "^7.3.6",
    "@astrojs/starlight": "^0.42.9",
    "@astrojs/svelte": "^9.1.2",
    "@faker-js/faker": "^10.6.0",
    "astro": "^7.4.7",
    "material-svelte-headless-table": "*",
    "svelte": "^5.57.3",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "devDependencies": {
    "svelte-check": "^4.7.8"
  }
}
