{
  "name": "material-svelte-table-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "pnpm --filter material-svelte-table-docs dev",
    "check": "turbo run check",
    "test": "turbo run test",
    "docs:build": "pnpm --filter material-svelte-table-docs build",
    "docs:dev": "pnpm --filter material-svelte-table-docs dev",
    "docs:preview": "pnpm --filter material-svelte-table-docs preview",
    "lib:build": "pnpm --filter material-svelte-table build",
    "lib:test": "pnpm --filter material-svelte-table test",
    "storybook": "pnpm --filter material-svelte-table storybook",
    "storybook:build": "pnpm --filter material-svelte-table build-storybook",
    "format": "prettier --write \"**/*.{js,ts,md}\""
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "2.3.3"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "packageManager": "pnpm@9.3.0"
}
