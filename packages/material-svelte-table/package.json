{
  "name": "material-svelte-table",
  "version": "4.0.0-alpha.0",
  "license": "MIT",
  "description": "A fully featured Svelte Material UI (SMUI) implementation of TanStack Table V9 for Svelte 5, written from the ground up in TypeScript.",
  "author": "Adhi Ravishankar",
  "keywords": [
    "svelte",
    "svelte5",
    "svelte-table",
    "smui",
    "material-table",
    "tanstack table",
    "data table"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/adhiravishankar/material-svelte-table"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./locales/*": {
      "types": "./dist/locales/*.d.ts",
      "default": "./dist/locales/*.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "node scripts/build-styles.mjs && svelte-package -i src/lib -o dist",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "storybook": "node scripts/build-styles.mjs && storybook dev -p 6006",
    "build-storybook": "node scripts/build-styles.mjs && storybook build",
    "styles": "node scripts/build-styles.mjs"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "dependencies": {
    "@smui/button": "^9.0.6",
    "@smui/checkbox": "^9.0.6",
    "@smui/common": "^9.0.6",
    "@smui/dialog": "^9.0.6",
    "@smui/form-field": "^9.0.6",
    "@smui/icon-button": "^9.0.6",
    "@smui/linear-progress": "^9.0.6",
    "@smui/list": "^9.0.6",
    "@smui/menu": "^9.0.6",
    "@smui/menu-surface": "^9.0.6",
    "@smui/switch": "^9.0.6",
    "@smui/textfield": "^9.0.6",
    "@tanstack/match-sorter-utils": "9.2.6",
    "@tanstack/svelte-table": "9.3.1",
    "@tanstack/virtual-core": "3.19.8",
    "highlight-words": "2.0.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@material-design-icons/svg": "^0.14.15",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-svelte-csf": "^5.1.5",
    "@storybook/addon-themes": "^10.6.5",
    "@storybook/svelte-vite": "^10.6.5",
    "@sveltejs/package": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.5",
    "jsdom": "^30.1.3",
    "storybook": "^10.6.5",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
