{
  "name": "shadcn-svelte-tanstack-table",
  "version": "0.1.0",
  "license": "MIT",
  "description": "A fully featured shadcn-svelte implementation of TanStack Table V9 for Svelte 5, written from the ground up in TypeScript.",
  "author": "Adhi Ravishankar",
  "keywords": [
    "svelte",
    "svelte5",
    "svelte-table",
    "shadcn",
    "shadcn-svelte",
    "tanstack table",
    "data table"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adhiravishankar/svelte-tables.git",
    "directory": "packages/shadcn-tanstack-table"
  },
  "homepage": "https://github.com/adhiravishankar/svelte-tables/tree/main/packages/shadcn-tanstack-table",
  "bugs": {
    "url": "https://github.com/adhiravishankar/svelte-tables/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./locales/*": {
      "types": "./dist/locales/*.d.ts",
      "default": "./dist/locales/*.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "svelte-package -i src/lib -o dist",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "svelte": "^5.0.0",
    "tailwindcss": "^4.0.0"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.62.0",
    "@tanstack/match-sorter-utils": "9.2.6",
    "@tanstack/svelte-table": "9.3.1",
    "@tanstack/virtual-core": "3.19.8",
    "bits-ui": "^2.20.2",
    "clsx": "^2.1.1",
    "highlight-words": "2.0.0",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@material-design-icons/svg": "^0.14.15",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-svelte-csf": "^5.1.5",
    "@storybook/addon-themes": "^10.6.5",
    "@storybook/svelte-vite": "^10.6.5",
    "@sveltejs/package": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "jsdom": "^30.1.3",
    "shadcn-svelte": "^1.7.1",
    "storybook": "^10.6.5",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
