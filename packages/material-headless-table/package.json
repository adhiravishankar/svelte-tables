{
  "name": "material-svelte-headless-table",
  "version": "0.1.0",
  "license": "MIT",
  "description": "A Material Design data table for Svelte 5, built on Svelte Headless Table, Svelte Virtual List and Svelte Material UI.",
  "author": "Adhi Ravishankar",
  "keywords": [
    "svelte",
    "svelte5",
    "svelte-table",
    "smui",
    "material-table",
    "headless table",
    "data table"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adhiravishankar/svelte-tables.git",
    "directory": "packages/material-headless-table"
  },
  "homepage": "https://github.com/adhiravishankar/svelte-tables/tree/main/packages/material-headless-table",
  "bugs": {
    "url": "https://github.com/adhiravishankar/svelte-tables/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./locales/*": {
      "types": "./dist/locales/*.d.ts",
      "default": "./dist/locales/*.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "node scripts/build-styles.mjs && svelte-package -i src/lib -o dist",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "styles": "node scripts/build-styles.mjs",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "dependencies": {
    "@humanspeak/svelte-headless-table": "^7.0.1",
    "@humanspeak/svelte-virtual-list": "^0.5.15",
    "@smui/button": "^9.0.6",
    "@smui/checkbox": "^9.0.6",
    "@smui/common": "^9.0.6",
    "@smui/form-field": "^9.0.6",
    "@smui/icon-button": "^9.0.6",
    "@smui/list": "^9.0.6",
    "@smui/menu": "^9.0.6",
    "@smui/switch": "^9.0.6",
    "@smui/textfield": "^9.0.6"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@material-design-icons/svg": "^0.14.15",
    "@sveltejs/package": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.5",
    "jsdom": "^30.1.3",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
